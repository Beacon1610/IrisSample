<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".SubjectListActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/gradient_background"
            app:title="Danh sách môn học"
            app:titleTextColor="@android:color/white"
            app:popupTheme="@style/AppTheme.PopupOverlay" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Header thông tin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_background"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quản lý các môn học trong hệ thống"
                android:textSize="14sp"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>

        <!-- Thanh tìm kiếm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <EditText
                android:id="@+id/editSearchSubject"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_bar"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:hint="Tìm kiếm môn học hoặc mã môn..."
                android:textColorHint="@color/colorTextHint"
                android:textSize="14sp"
                android:textColor="@color/colorTextPrimary"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch" />
        </LinearLayout>

        <!-- Danh sách môn học -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSubjects"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Trạng thái trống -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có môn học nào"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhấn nút bên dưới để thêm môn học mới"
                android:textSize="14sp"
                android:textColor="@color/colorTextHint"
                android:layout_marginTop="8dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nút thêm môn học (FAB) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddSubject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@android:color/white"
        app:elevation="6dp" />

    <!-- Nút nhập CSV -->
    <ImageButton
        android:id="@+id/btnImportSubjectsCsv"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="84dp"
        android:src="@drawable/ic_upload_white"
        android:background="@drawable/bg_fab_secondary"
        android:scaleType="center"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="Nhập CSV môn học" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
