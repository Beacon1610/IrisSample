<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@color/colorCard">

    <!-- Avatar viết tắt -->

    <!-- Thông tin -->
    <ImageView
        android:id="@+id/tvAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/avatar_circle_bg"
        android:gravity="center"
        android:text="SV"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStudentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Tên sinh viên"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="12dp" />

    <!-- Nút hành động -->

    <ImageButton
        android:id="@+id/btnCheckIn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_agenda"
        android:background="@android:color/transparent"
        android:scaleType="center"
        android:tint="@color/colorPrimary"
        android:contentDescription="Điểm danh"
        android:layout_marginStart="4dp" />
    <ImageButton
        android:id="@+id/btnEnroll"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_camera"
        android:background="@android:color/transparent"
        android:scaleType="center"
        android:tint="@color/colorPrimaryDark"
        android:contentDescription="Đăng ký mống mắt"
        android:layout_marginStart="4dp" />

    <ImageButton
        android:id="@+id/btnUnenroll"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="@android:color/transparent"
        android:scaleType="center"
        android:tint="@color/colorError"
        android:contentDescription="Huỷ đăng ký"
        android:layout_marginStart="4dp" />

    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_edit"
        android:background="@android:color/transparent"
        android:scaleType="center"
        android:tint="@color/colorWarning"
        android:contentDescription="Chỉnh sửa"
        android:layout_marginStart="4dp" />
</LinearLayout>

