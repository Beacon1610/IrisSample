<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    tools:context=".AttendanceManagementActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/gradient_background"
            app:title="Quản lý điểm danh"
            app:titleTextColor="@android:color/white"
            app:popupTheme="@style/AppTheme.PopupOverlay" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Thông tin môn học -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/textSubjectInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin môn học"
            android:textSize="15sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/textRecordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 bản ghi"
            android:textSize="13sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Thanh Tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorCard"
        android:elevation="2dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnTabExport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Xuất dữ liệu"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimaryDark"
            android:background="@android:color/transparent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTabEmail"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Gửi email"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:background="@android:color/transparent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btnTabView"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Xem chi tiết"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:background="@android:color/transparent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp" />
    </LinearLayout>

    <!-- ==================== TAB XUẤT DỮ LIỆU ==================== -->
    <ScrollView
        android:id="@+id/layoutExportTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xuất dữ liệu điểm danh"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xuất toàn bộ dữ liệu điểm danh ra tệp CSV"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="20dp" />

                    <Button
                        android:id="@+id/btnExportCsv"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Xuất tệp CSV"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:background="@drawable/button_primary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- ==================== TAB GỬI EMAIL ==================== -->
    <ScrollView
        android:id="@+id/layoutEmailTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Thêm người nhận -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorCard"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thêm người nhận"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Địa chỉ email"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/editEmailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/edit_text_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextPrimary"
                        android:hint="Nhập địa chỉ email"
                        android:textColorHint="@color/colorTextHint"
                        android:inputType="textEmailAddress"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên người nhận"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/editRecipientName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/edit_text_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextPrimary"
                        android:hint="Nhập tên người nhận"
                        android:textColorHint="@color/colorTextHint"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAddEmail"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Thêm"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:background="@drawable/button_primary"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnImportEmailCsv"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Nhập CSV"
                            android:textSize="14sp"
                            android:textAllCaps="false"
                            android:textColor="@color/colorPrimaryDark"
                            android:background="@drawable/button_secondary"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Danh sách người nhận -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorCard"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <CheckBox
                            android:id="@+id/checkBoxSelectAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chọn tất cả"
                            android:textSize="14sp"
                            android:textColor="@color/colorTextPrimary"
                            android:buttonTint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/textSelectedCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Đã chọn: 0"
                            android:textSize="13sp"
                            android:textColor="@color/colorTextSecondary"
                            android:gravity="end" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerEmailList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/textEmptyEmailList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chưa có người nhận nào"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextHint"
                        android:gravity="center"
                        android:padding="20dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnSendEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Gửi email điểm danh"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:background="@drawable/button_success"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- ==================== TAB XEM CHI TIẾT ==================== -->
    <LinearLayout
        android:id="@+id/layoutViewTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Bộ lọc -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/editSearchStudent"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextPrimary"
                        android:hint="Tìm sinh viên..."
                        android:textColorHint="@color/colorTextHint"
                        android:inputType="text"
                        android:singleLine="true"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnSelectDate"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Chọn ngày"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimaryDark"
                        android:background="@drawable/button_secondary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFilterAll"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Tất cả"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:background="@drawable/button_primary"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnFilterAttended"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Có mặt"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimaryDark"
                        android:background="@drawable/button_secondary"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnFilterNotAttended"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Vắng mặt"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimaryDark"
                        android:background="@drawable/button_secondary"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnImportCsvView"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Nhập CSV"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/colorPrimaryDark"
                        android:background="@drawable/button_secondary"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Thống kê -->
        <TextView
            android:id="@+id/textViewStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@color/cardAccentTeal"
            android:textSize="13sp"
            android:textColor="@color/colorPrimaryDark"
            android:text="Thống kê điểm danh" />

        <!-- Danh sách điểm danh -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAttendanceList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/textEmptyAttendanceList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Chưa có dữ liệu điểm danh"
                android:textSize="15sp"
                android:textColor="@color/colorTextHint"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
